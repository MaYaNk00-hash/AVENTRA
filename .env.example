# =================================================================
# AVENTRA ENTERPRISE SELF-HOSTED PRODUCTION CONFIGURATION
# =================================================================

# --- Deployment Environment ---
ENVIRONMENT=PRODUCTION
DATA_RESIDENCY_REGION=US_EAST
DEPLOYMENT_MODE=AIR_GAPPED_OFFLINE

# --- Enterprise Database (PostgreSQL) ---
POSTGRES_USER=aventra
POSTGRES_PASSWORD=ReplaceWithStrongSecretDBPassword2026!
POSTGRES_DB=aventra_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aventra:ReplaceWithStrongSecretDBPassword2026!@postgres:5432/aventra_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Security & JWT Cryptography ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ReplaceWithRandom64CharHexKeyForProductionJWTAuth2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Enterprise Governance & Autonomy Guardrails ---
CONFIDENCE_THRESHOLD=0.85
PRICE_TOLERANCE_PCT=2.0
DRIFT_SIMILARITY_THRESHOLD=0.60
AUTO_APPLY_DRIFT=false
PROHIBIT_AUTONOMOUS_EXTERNAL_EMAIL=true

# --- Licensing & Entitlements ---
# Set by administrator via /api/licensing/activate or injected here:
AVENTRA_LICENSE_TOKEN=

# --- Service Ports & Reverse Proxy ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NEXT_PUBLIC_API_URL=/api
